# Example Terraform variables file for main configuration
# Copy this to terraform.tfvars and customize the values

environment_name = "dev"
aws_region      = "ap-southeast-2"
aws_profile     = "default"
vpc_cidr        = "10.0.0.0/16"

common_tags = {
  Project     = "ephemeral-environments"
  Environment = "dev"
  Owner       = "enigma-global"
  ManagedBy   = "terraform"
}