{
  "name": "Development Configuration",
  "description": "Configuration optimized for development team workflows",
  "aws": {
    "region": "us-west-2",
    "profile": "development"
  },
  "defaults": {
    "instanceType": "t3.small",
    "maxLifetime": 72,
    "costThreshold": 100
  },
  "terraform": {
    "stateBackend": {
      "bucket": "mycompany-ephemeral-dev-terraform-state",
      "region": "us-west-2",
      "dynamodbTable": "mycompany-ephemeral-dev-terraform-locks"
    }
  },
  "git": {
    "webhookSecret": "your-webhook-secret-here",
    "repositoryUrl": "https://github.com/mycompany/myapp.git",
    "webhookPort": 3000
  },
  "profiles": [
    {
      "name": "feature-branch",
      "description": "Feature branch testing environment",
      "defaults": {
        "template": "fullstack",
        "region": "us-west-2",
        "instanceType": "t3.small",
        "maxLifetime": 48,
        "costThreshold": 75,
        "autoDestroy": true
      },
      "aws": {
        "region": "us-west-2"
      },
      "terraform": {
        "stateBackend": {
          "bucket": "mycompany-ephemeral-feature-terraform-state",
          "region": "us-west-2",
          "dynamodbTable": "mycompany-ephemeral-feature-terraform-locks"
        }
      },
      "git": {
        "webhookSecret": "your-webhook-secret-here",
        "repositoryUrl": "https://github.com/mycompany/myapp.git",
        "webhookPort": 3000
      },
      "tags": {
        "Project": "myapp",
        "Environment": "feature-testing",
        "Team": "development",
        "CostCenter": "engineering",
        "AutoCleanup": "enabled"
      }
    },
    {
      "name": "integration-testing",
      "description": "Integration testing with external services",
      "defaults": {
        "template": "fullstack",
        "region": "us-west-2",
        "instanceType": "t3.medium",
        "maxLifetime": 24,
        "costThreshold": 150,
        "autoDestroy": true
      },
      "aws": {
        "region": "us-west-2"
      },
      "terraform": {
        "stateBackend": {
          "bucket": "mycompany-ephemeral-integration-terraform-state",
          "region": "us-west-2",
          "dynamodbTable": "mycompany-ephemeral-integration-terraform-locks"
        }
      },
      "tags": {
        "Project": "myapp",
        "Environment": "integration-testing",
        "Team": "qa",
        "CostCenter": "engineering",
        "TestType": "integration"
      }
    }
  ]
}