{
  "name": "demo-webapp-config",
  "description": "Configuration for deploying the ephemeral demo web application",
  "environment": {
    "provider": "aws",
    "region": "us-east-1",
    "instanceType": "t3.micro",
    "autoCleanup": true,
    "cleanupAfter": "2h",
    "tags": {
      "Project": "EphemeralDemo",
      "Environment": "Demo",
      "Application": "WebApp"
    }
  },
  "application": {
    "template": "demo",
    "name": "ephemeral-demo-webapp",
    "version": "1.0.0",
    "customizations": {
      "docker": {
        "env": {
          "NODE_ENV": "production",
          "LOG_LEVEL": "info"
        }
      }
    }
  },
  "git": {
    "integration": {
      "enabled": true,
      "provider": "github",
      "webhookUrl": "https://api.github.com/repos/your-org/your-repo/hooks",
      "events": ["pull_request", "push"]
    },
    "branchMapping": {
      "main": "production",
      "develop": "staging",
      "feature/*": "development"
    }
  },
  "terraform": {
    "backend": {
      "type": "s3",
      "config": {
        "bucket": "ephemeral-demo-terraform-state",
        "key": "demo-webapp/${ENVIRONMENT_ID}/terraform.tfstate",
        "region": "us-east-1",
        "encrypt": true
      }
    },
    "variables": {
      "app_name": "ephemeral-demo-webapp",
      "environment_id": "${ENVIRONMENT_ID}",
      "instance_type": "t3.micro",
      "min_capacity": 1,
      "max_capacity": 3,
      "desired_capacity": 1
    }
  },
  "monitoring": {
    "enabled": true,
    "healthCheck": {
      "path": "/health",
      "interval": 30,
      "timeout": 10,
      "healthyThreshold": 2,
      "unhealthyThreshold": 3
    },
    "metrics": {
      "cpu": {
        "enabled": true,
        "threshold": 80
      },
      "memory": {
        "enabled": true,
        "threshold": 85
      },
      "requests": {
        "enabled": true,
        "threshold": 1000
      }
    },
    "alerts": {
      "email": ["devops@example.com"],
      "slack": {
        "webhook": "https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK"
      }
    }
  },
  "security": {
    "allowedIPs": ["0.0.0.0/0"],
    "sslEnabled": true,
    "certificateArn": "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"
  }
}